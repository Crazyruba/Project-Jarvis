# Kopieer naar .env.local en vul in (wordt niet gecommit).
# OpenClaw Gateway WebSocket (standaard op dezelfde machine)
VITE_OPENCLAW_URL=ws://127.0.0.1:18789
# Gateway token: `openclaw config get gateway.auth.token`
VITE_OPENCLAW_TOKEN=
# Taal voor spraakherkenning en spraak
VITE_JARVIS_LANG=nl-NL
